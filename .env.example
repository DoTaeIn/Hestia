NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Login methods shown by the Next.js shell. Configure each provider in Auth first.
NEXT_PUBLIC_AUTH_EMAIL_LINK=true
NEXT_PUBLIC_AUTH_PASSWORD=false
NEXT_PUBLIC_AUTH_OAUTH_PROVIDERS=
# Legacy Google toggle; prefer NEXT_PUBLIC_AUTH_OAUTH_PROVIDERS=google.
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false

# Canonical origin; set the real HTTPS site before production build.
# HTTPS enables Secure session cookies and HSTS automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Public Turnstile site key; the matching secret belongs in Supabase Auth, not this app.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
