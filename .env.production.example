# Fill these BEFORE the production build; NEXT_PUBLIC_* is embedded in browser bundles.
NEXT_PUBLIC_SITE_URL=https://docs.your-domain.example
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
NEXT_PUBLIC_AUTH_EMAIL_LINK=true
NEXT_PUBLIC_AUTH_PASSWORD=false
NEXT_PUBLIC_AUTH_OAUTH_PROVIDERS=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=REPLACE_WITH_PUBLIC_SITE_KEY
# The matching CAPTCHA secret belongs in Supabase Auth settings.
# No service-role key, JWT signing secret or SMTP password belongs in NEXT_PUBLIC_*.
